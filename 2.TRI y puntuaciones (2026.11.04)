#---------------------------------------------------------


#Recuperar las probabilidades

prob_acum_FAO <- Est_FAO$probs.rs

colnames(prob_acum_FAO) <- c(
  "P_moderada_mas_FAO",
  "P_grave_FAO"
)

#Tabla asignaciones de rangos

tabla_asignacion_FAO <- data.frame(
  Punt_Directa = 0:8,
  P_moderada_mas_FAO = prob_acum_FAO[, 1],
  P_grave_FAO = prob_acum_FAO[, 2],
  theta = as.numeric(modelo_fao$a)
) %>%
  mutate(
    # Probabilidades de categorías exclusivas
    P_seguridad_FAO = 1 - P_moderada_mas_FAO,
    P_moderada_FAO = P_moderada_mas_FAO - P_grave_FAO,
    
    # Probabilidades expresadas en porcentaje
    P_moderada_mas_pct_FAO = 100 * P_moderada_mas_FAO,
    P_grave_pct_FAO = 100 * P_grave_FAO,
    P_moderada_pct_FAO = 100 * P_moderada_FAO
