#Determinado que RASCH FAO ofrece mejor ajuste se extraen puntuaciones



Est_FAO <- equating.fun(modelo_fao) #Estimación EQUATING Base (FAO)

#-------------
#2.1.a.Equating original: conserva el estándar FAO
#-------------


# 1. Extraer los umbrales ajustados (por ejemplo, moderada y grave)
Umbral_FAO <- Est_FAO$adj.thres

Umbral_FAO

# 2. Calcular la asignación probabilística con el modelo y los umbrales
prevalencias_fao <- prob.assign(modelo_fao, sthres = Umbral_FAO)

# 3. Ver las prevalencias acumuladas en porcentaje (multiplicadas por 100)
porcentajes_prevalencia <- prevalencias_fao$sprob * 100
print(porcentajes_prevalencia)

# Prevalencias
# Matriz de probabilidades acumuladas por puntuación directa
prob_acum_FAO <- Est_FAO$probs.rs
# Asignar nombres explícitos a las tres columnas
colnames(prob_acum_FAO) <- c(
  "P_moderada_mas",
  "P_grave"
)

# Tabla de consulta de la calculadora punt 1:8
tabla_prob_FIES_FAO <- data.frame(
  Punt_Directa = 0:8,
  P_moderada_mas = prob_acum_FAO[, 1],
  P_grave = prob_acum_FAO[, 2]
)



# Probabilidades de las cuatro categorías exclusivas
tabla_prob_FIES_FAO$P_seguridad <-
  1 - tabla_prob_FIES_FAO$P_moderada_mas

tabla_prob_FIES_FAO$P_moderada <-
  tabla_prob_FIES_FAO$P_moderada_mas -
  tabla_prob_FIES_FAO$P_grave

# P_grave ya es la probabilidad de la categoría grave

# Mostrar en porcentajes
cols_prob_FAO <- grep("^P_", names(tabla_prob_FIES_FAO))

tabla_prob_FIES_FAO[cols_prob_FAO] <-
  lapply(tabla_prob_FIES_FAO[cols_prob_FAO], function(x) round(100*x, 2))

print(tabla_prob_FIES_FAO)



rowSums(tabla_prob_FIES_FAO[
  , c("P_seguridad", "P_moderada", "P_grave")
])

prev_acum_FAO <- as.numeric(Est_FAO$prevs)

