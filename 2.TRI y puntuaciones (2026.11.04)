FIES_hogares_resultados <- FIES_FOESSA_Hogares %>%
  mutate(
    Punt_Directa = rowSums(
      across(all_of(items_FIES)),
      na.rm = FALSE
    )
  ) %>%
  left_join(
    tabla_asignacion_FAO,
    by = "Punt_Directa"
  ) %>%
  mutate(
    # Clasificación según los umbrales theta de FAO
    Rango_FAO = case_when(
      is.na(theta) ~ NA_character_,
      theta >= unname(Umbral_FAO["FI_sev"]) ~ "Grave",
      theta >= unname(Umbral_FAO["FI_mod+"]) ~ "Moderada",
      TRUE ~ "Seguridad alimentaria"
    )
  ) %>%
  select(
    NUCU,
    Punt_Directa,
    theta,
    P_moderada_mas_FAO,
    P_moderada_FAO,
    P_grave_pct_FAO,
    P_moderada_mas_pct_FAO,
    P_moderada_pct_FAO,
    P_grave_pct_FAO,
    Rango_FAO
  )



