#Submuestras EFA - CFA

BBDD_EFA <- read.csv("EFA.csv", header = TRUE, sep = ";")
head(BBDD_EFA)
str(BBDD_EFA)
summary(BBDD_EFA)


BBDD_CFA <- read.csv("CFA.csv", header = TRUE, sep = ";")
head(BBDD_EFA)
str(BBDD_EFA)
summary(BBDD_EFA)


#Cambiar escala a las vars FIES (en el ejemplo se convierten a numéricas)

cols<-c("E84_1R", "E84_2R", "E84_3R", "E84_4R", "E84_5R", 
        "E84_6R", "E84_7R", "E84_8R")
BBDD_CFA[cols] <- lapply(BBDD_CFA[cols], as.ordered)
BBDD_CFA$A2 <- as.factor(BBDD_CFA$A2)
sapply(BBDD_CFA, class)

BBDD_EFA[cols] <- lapply(BBDD_EFA[cols], as.numeric)
sapply(BBDD_EFA, class)

FIES_FOESSA[cols] <- lapply(FIES_FOESSA[cols], as.numeric)
sapply(FIES_FOESSA, class)



#Base sólo con las variables del FIES
vars_FIES <- FIES_FOESSA[, c("E84_1R", "E84_2R", "E84_3R", "E84_4R", "E84_5R",
                             "E84_6R", "E84_7R", "E84_8R")]


sapply(vars_FIES, class)
head(vars_FIES)
summary(vars_FIES)



#===============================
#1.Validez estructura EFA - CFA
#===============================

###EFA Validación

# Correlaciones tetracóricas
Matriz_Validacion <- tetrachoric(BBDD_EFA)$rho

KMO(Matriz_Validacion)

cortest.bartlett(
  Matriz_Validacion,
  n = nrow(BBDD_EFA )
)


# EFA 1 factor y prueba var explicada
efa_Validacion <- fa(BBDD_EFA ,
                     nfactors = 1,
                     n.obs = nrow(BBDD_EFA ),
                     fm = "minres",
                     rotate = "oblimin",
                     cor = "tetrachoric",
                     scores = "regression")

# Resultados
print(efa_Validacion$loadings, cutoff = .30)
efa_Validacion$communality


###CFA Valdación

#Especificación del modelo conceptual (unidimensional)
Onefactor<-'FIES =~ E84_1R + E84_2R + E84_3R + E84_4R + E84_5R + 
  E84_6R + E84_7R + E84_8R'



#realización del AFC para la primera estructura
CFAone <- cfa(Onefactor, data=BBDD_CFA, estimator="DWLS", ordered=names(BBDD_CFA))
summary(CFAone, fit.measures=TRUE)

fitMeasures(CFAone)
semPaths(CFAone, intercepts = FALSE,edge.label.cex=1.5, optimizeLatRes = TRUE, groups = "lat",pastel = TRUE, exoVar = FALSE, sizeInt=5,edge.color ="black",esize = 6, label.prop=2,sizeLat = 6,"std", layout="circle2")

#Consistencia interna Kuder-Richardson (KR20) https://methods.sagepub.com/ency/edvol/the-sage-encyclopedia-of-communication-research-methods/chpt/reliability-kuderrichardson-formula#_
#Se calcula el alpha, ya que matemáticame es el mismo cálculo.
#Calcular el coeficiente y resultado (raw alpha y "if item dropped")



fiabilidad <- alpha(vars_FIES)

print(fiabilidad)


#-----------------------
#Invarianza género
#-----------------------

# Baseline

base.line <- cfa(Onefactor, data = BBDD_CFA, estimator = "DWLS", orthogonal=FALSE)


# configural invariance

inv.conf <- cfa(Onefactor, data = BBDD_CFA, group = "A2", estimator = "DWLS")

# Metric invariance

inv.metric <- cfa(Onefactor, data = BBDD_CFA, group = "A2", estimator = "DWLS", group.equal = "loadings")

# Scalar invariance
inv.scalar <- cfa(Onefactor, data = BBDD_CFA, group = "A2",
                  group.equal = c("thresholds", "loadings"), estimator = "DWLS")


# strict invariance
inv.strict <- cfa(Onefactor, data = BBDD_CFA, group = "A2",
                  group.equal = c("thresholds", "loadings", "residuals"), estimator = "DWLS")



# model comparison tests
fitMeasures(base.line)
fitMeasures(inv.conf)
fitMeasures(inv.metric)
fitMeasures(inv.scalar)
fitMeasures(inv.strict)


fit.stats <- rbind(fitmeasures(base.line, fit.measures = c("chisq", "df", "rmsea","srmr", "tli", "cfi", "aic")),
                   fitmeasures(inv.conf, fit.measures = c("chisq", "df", "rmsea","srmr", "tli", "cfi", "aic")),
                   fitmeasures(inv.metric, fit.measures = c("chisq", "df", "rmsea","srmr", "tli", "cfi", "aic")),
                   fitmeasures(inv.scalar, fit.measures = c("chisq", "df", "rmsea","srmr", "tli", "cfi", "aic")),
                   fitmeasures(inv.strict, fit.measures = c("chisq", "df", "rmsea","srmr", "tli", "cfi", "aic")))

rownames(fit.stats) <- c("baseline", "configural", "metric","scalar", "strict")
fit.stats


#Guardar los ajustes de los modelos de invarianza como un Excel

fit.stats.excel <- data.frame(
  Modelo = rownames(fit.stats),
  fit.stats,
  row.names = NULL
)

write_xlsx(as.data.frame(fit.stats.excel), "invarianza.xlsx")





#==========================================================
#2.RASCH FAO (RM Weights)
#==========================================================

modelo_fao <- RM.w(.data = vars_FIES, .w = FIES_FOESSA$peso) #Modelo
summary(modelo_fao)


modelo_fao$reliab #Fiabilidad del modelo


#parámetro severidad items (parámetro b, irt)
tabla_items <- data.frame(
  Item = names(modelo_fao$b),
  Severidad_b = modelo_fao$b,
  Error_Std = modelo_fao$se.b
)

print(tabla_items)

# Extraer infit y outfit de los ítems (Ajuste adecuado entre 0.7 y 1.3)
tabla_ajuste <- data.frame(
  Item = names(modelo_fao$infit),
  Infit = modelo_fao$infit,
  Outfit = modelo_fao$outfit
)

print(tabla_ajuste)


#Asignar punt directa y Theta a cada sujeto
FIES_FOESSA$Punt_Directa <- rowSums(vars_FIES, na.rm = TRUE) #Puntuación directa
FIES_FOESSA$thetaFAO <- modelo_fao$a[FIES_FOESSA$Punt_Directa+1] #Variable ThetaFAO



#PUNTOS DE CORTE FAO (Basados en probabilidad)

corte <- equating.fun(modelo_fao)
corte$prevs * 100 #Porcentaje en cada rango FAO (Prevalencia País)
corte$adj.thres
probabilidades <- corte$probs.rs
corte$probs.rs #Extrae las probabilidades de puntuar en rango grave y moderado de las puntuaciones directas
#Con esta tabla se construye la calculadora.

#Se asigna un rango a cada persona basado en la probabilidad de pertenecer a él
#Es una aproximación, la prevalencia real de españa se calcula con el Corte (función equating)
#Tiene un interés internacional, pero no es muy práctico para estudiar intraEspaña


punt <- FIES_FOESSA$Punt_Directa
FIES_FOESSA$prob_mod_sev <- probabilidades[
  as.character(punt), "FI_mod+"
]

FIES_FOESSA$prob_grave <- probabilidades[
  as.character(punt), "FI_sev"
]


FIES_FOESSA$Rango_FAO_Prob <- factor(
  ifelse(
    is.na(punt),
    NA_character_,
    ifelse(
      punt == 0,
      "1. Seguridad alimentaria",
      ifelse(
        FIES_FOESSA$prob_grave >= 0.5,
        "4. Grave inseguridad alimentaria",
        ifelse(
          FIES_FOESSA$prob_mod_sev >= 0.5,
          "3. Moderada inseguridad alimentaria",
          "2. Leve inseguridad alimentaria"
        )
      )
    )
  ),
  levels = c(
    "1. Seguridad alimentaria",
    "2. Leve inseguridad alimentaria",
    "3. Moderada inseguridad alimentaria",
    "4. Grave inseguridad alimentaria"
  )
)

#Resultados

table(FIES_FOESSA$Rango_FAO, useNA = "ifany") 

round(
  prop.table(table(FIES_FOESSA$Rango_FAO)) * 100,
  2
)


#Gruardar base de datos con theta FAO, Probabilidades y rangos asignados
write_xlsx(FIES_FOESSA, "FIES_FAO.xlsx")


#Guardar tabla de resultados rangos

Tabla_FAO_Results <- table(FIES_FOESSA$Rango_FAO, useNA = "ifany") 

Talbla_FAO_Results_2 <- round(
  prop.table(table(FIES_FOESSA$Rango_FAO)) * 100,
  2
)

write_xlsx(as.data.frame(Tabla_FAO_Results), "Tabla_FAO_Results.xlsx")
write_xlsx(as.data.frame(Talbla_FAO_Results_2), "Talbla_FAO_Results_2.xlsx")


#-------------------------------------
#Hay una limitación del modelo Rasch, que es que no tiene en cuenta la discriminación 
#diferencial entre ítems. De tal modo, que un modelo IRT de 3 parámetros 
#permitirá alcanzar puntuaciones ponderadas y un abanico más amplio de resultados (numéricos)

#===============================
#3.TRI (Modelo de Rasch y Modelo 2pl - Mejor ajuste en 2pl -)
#===============================

#-------------------------------
#Normalizar PESO, ponderación
#-------------------------------

FIES_FOESSA$peso <- BBDD_Foessa$peso[
  match(FIES_FOESSA$numero, BBDD_Foessa$numero)
] #Añade la variable peso

#Añade la variable peso normalizada
FIES_FOESSA$peso_norm <- FIES_FOESSA$peso * (nrow(vars_FIES) / sum(FIES_FOESSA$peso))

head(FIES_FOESSA$peso)
str(FIES_FOESSA$peso)

#-------------------------------
#Análisis TRI NACIONAL (Rasch Model (mirt) y 2pl (mirt)
#-------------------------------

modelo_rasch <- mirt(vars_FIES, 1, itemtype = "Rasch", survey.weights = FIES_FOESSA$peso_norm) #no ofrece la misma estimación que el RASCH FAO (Estimado CML Pond) y MIRT (ML), pero el MIRT permite comprar RASCH y 2pl
modelo_2pl <- mirt(vars_FIES, 1, itemtype = "2PL", survey.weights = FIES_FOESSA$peso_norm)




coef(modelo_rasch, IRTpars = TRUE, simplify = TRUE)
coef(modelo_2pl, IRTpars = TRUE, simplify = TRUE)


#Ajuste modelos
anova(modelo_rasch, modelo_2pl)


M2(modelo_rasch, type = "C2") #El ajuste tipo C2 es corregido para muestras altas
M2(modelo_2pl, type = "C2")



itemfit(modelo_rasch)
itemfit(modelo_2pl) 
apply(vars_FIES, 2, table)

plot(modelo_2pl, type = "trace")

#Extraer patrones de respuesta
patrones_BBDD <- as.data.frame(table(
  apply(vars_FIES, 1, paste0, collapse = "")
))

patrones_BBDD <- patrones_BBDD[order(-patrones_BBDD$Freq), ]

head(patrones_BBDD, 20)
str(patrones_BBDD)


theta2pl <- fscores(modelo_2pl, method = "EAP")[, "F1"]
theta2pl <- as.numeric(theta2pl)

summary(theta2pl)
str(theta2pl)




##================================================
##4.Construcción de la puntuación TRI ASCH FAO
##================================================

#Es necesario hacer el RASCH FAO y 2PL previamente



#1.Simple: suma directa / simple / raw (cada item positivo suma 1)
#2.Ordinal (ponderada): se ordenan por b. El más sencillo punt 1, el más severo 8.
#3. 3 niveles: se calcula la distancia de b en RASCH FAO
#3(cont). Se hacen tres grupos y se pondera: 1-1-1-2-2-3-3-3
#3(cont). Estos 3 grupos se basan en la distancia de b.
#4. ThetaFAO: valor theta del modelo RASCH FAO.


##Cálculo de las distancias de theta en el modelo RASCH FAO

b_fao <- c(
  E84_3R = -3.3252320,
  E84_1R = -2.6475239,
  E84_2R = -2.5897119,
  E84_5R = -0.4574329,
  E84_4R = 0.4872636,
  E84_7R = 2.0117303,
  E84_6R = 2.7278959,
  E84_8R = 3.7932487
)

data.frame(
  item = names(b_fao),
  b_fao = b_fao,
  distancia = c(NA, diff(b_fao))
)


#-------------------------------
# Pesos (formas de corrección - ponderación)
#-------------------------------

w_simple <- rep(1, 8)

w_ordinal <- c(2,3,1,5,4,7,6,8) #jerarquía respecto a b

w_3niveles <- c(1, 1, 1, 2, 2, 3, 3, 3)

names(w_ordinal) <- names(vars_FIES)

# Índices
score_simple <- rowSums(vars_FIES)

score_ordinal <- as.numeric(
  as.matrix(vars_FIES) %*% w_ordinal
)

score_3niveles <- as.numeric(
  as.matrix(vars_FIES) %*% w_3niveles
)




# ------------------------------------------------------------
# Correlación entre los índices y theta Rasch FAO
# ------------------------------------------------------------

cor_indices <- cor(
  cbind(
    Simple = score_simple,
    Ordinal = score_ordinal,
    TresNiveles = score_3niveles,
    ThetaFAO= FIES_FOESSA$thetaFAO,
    Theta2pl=FIES_FOESSA$theta2pl
  ),
  method = "spearman"
)

round(cor_indices, 6)


# ------------------------------------------------------------
# Distribución de los índices
# ------------------------------------------------------------

summary(score_simple)
summary(score_ordinal)
summary(score_3niveles)



# ------------------------------------------------------------
# 4. Número de valores posibles
# ------------------------------------------------------------

length(unique(score_simple))
length(unique(score_ordinal))
length(unique(score_3niveles))



##===========================================================
#5.ELABORAR CALCULADORA
#============================================================

#Extraer las probabilidades de cada rango asociadas a la punt directa
#Ello permitirá ir elaborando la calculadora
#RANGOS FAO Rev: 
## SEGURIDAD == 0
## Leve prob mod < 0.5
## Moderada prob mod >= .5 & prob grave < .05
## Grave prob grave >= .5
#Son rangos revisados, porque el 0 se separa de leve y pasa a Seguridad

#Estos rangos se traduce en puntuaciones directas como
## SEGURIDAD = Puntuación simple 0
## Leve = Puntuaciones simples 1, 2 y 3
## Moderada = Puntuaciones simples 4, 5, 6 y 7
## Grave = Puntuaciones simples 8

# Crear tabla de la calculadora
Tabla_Prob_Rango_FAO <- data.frame(
  Punt_Directa = 0:8,
  Prob_Moderada = as.numeric(
    probabilidades[as.character(0:8), "FI_mod+"]
  ),
  Prob_Grave = as.numeric(
    probabilidades[as.character(0:8), "FI_sev"]
  )
)

# Mostrar como porcentajes
Tabla_Prob_Rango_FAO$Prob_Moderada_pct <-
  round(100 * Tabla_Prob_Rango_FAO$Prob_Moderada, 2)

Tabla_Prob_Rango_FAO$Prob_Grave_pct <-
  round(100 * Tabla_Prob_Rango_FAO$Prob_Grave, 2)

print(Tabla_Prob_Rango_FAO)

# Exportar para utilizarla en la calculadora
write_xlsx(Tabla_Prob_Rango_FAO, "Tabla_Prob_Rango_FAO.xlsx")




