)


#-------------------------------
#PATRÓN: Crear plantilla corrección patrones TRI estandarizado 0-100
#-------------------------------

# 256 patrones posibles
pat <- expand.grid(rep(list(0:1), 8))
names(pat) <- names(vars_FIES)

# Código del patrón
patron <- apply(pat, 1, paste0, collapse = "")

# Frecuencias observadas
obs <- table(apply(vars_FIES, 1, paste0, collapse = ""))

# Frecuencia de cada uno de los 256 patrones
frecuencia <- as.numeric(obs[patron])
frecuencia[is.na(frecuencia)] <- 0

# Theta de cada patrón
theta_pat <- as.numeric(
  fscores(
    modelo_2pl,
    response.pattern = as.matrix(pat),
    method = "EAP"
  )
)

# Tabla final
tabla_patrones <- data.frame(
  patron = patron,
  frecuencia = frecuencia,
  n_positivos = rowSums(pat),
  theta = theta_pat
)

tabla_patrones <- tabla_patrones[order(tabla_patrones$theta), ]
rownames(tabla_patrones) <- NULL

# Ordenar por theta
tabla_patrones <- tabla_patrones[order(tabla_patrones$theta), ]
rownames(tabla_patrones) <- NULL

#Estandarización 0 a 100 (min-max)

theta_min <- min(tabla_patrones$theta)
theta_max <- max(tabla_patrones$theta)

tabla_patrones$indice_0_100 <- round(
  100 * (tabla_patrones$theta - theta_min) /
    (theta_max - theta_min)
)

tabla_patrones


write_xlsx(tabla_patrones, "tabla_patrones.xlsx")




